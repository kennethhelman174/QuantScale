[Unit]
Description=QuantScale PAPER backend (user service)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/quantscale-app/current
EnvironmentFile=%h/.config/quantscale/environment
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true

[Install]
WantedBy=default.target
