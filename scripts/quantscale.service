[Unit]
Description=QuantScale 24/7 Bitcoin Prediction Market Execution Engine
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/quantscale
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5s
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=DATA_DIR=/data/quantscale
StandardOutput=append:/var/log/quantscale.log
StandardError=append:/var/log/quantscale.error.log
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
